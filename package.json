{
  "name": "guitar-workflow-toolkit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "native:check": "powershell -ExecutionPolicy Bypass -File native/juce-audio-engine/scripts/check-prereqs.ps1",
    "native:configure": "powershell -ExecutionPolicy Bypass -File native/juce-audio-engine/scripts/configure.ps1",
    "native:build": "powershell -ExecutionPolicy Bypass -File native/juce-audio-engine/scripts/build.ps1",
    "native:open": "powershell -ExecutionPolicy Bypass -File native/juce-audio-engine/scripts/open.ps1",
    "native:open:visual": "powershell -ExecutionPolicy Bypass -File native/juce-audio-engine/scripts/open.ps1",
    "native:open:plugin-standalone": "powershell -ExecutionPolicy Bypass -File native/juce-audio-engine/scripts/open-plugin-standalone.ps1",
    "native:open:thallbyssal": "powershell -ExecutionPolicy Bypass -File native/juce-audio-engine/scripts/open-thallbyssal.ps1",
    "native:shortcut": "powershell -ExecutionPolicy Bypass -File native/juce-audio-engine/scripts/create-shortcut.ps1",
    "lab:validate": "node AMP_SIM_LAB/test-harness/validate-lab-structure.mjs",
    "lab:test": "node AMP_SIM_LAB/test-harness/run-lab-tests.mjs",
    "lab:metrics": "node AMP_SIM_LAB/test-harness/run-audio-regression.mjs",
    "lab:di": "node AMP_SIM_LAB/test-harness/validate-di-files.mjs",
    "lab:di:strict": "node AMP_SIM_LAB/test-harness/validate-di-files.mjs --strict",
    "lab:founder-assets": "node AMP_SIM_LAB/test-harness/validate-founder-assets.mjs",
    "lab:audition": "node AMP_SIM_LAB/test-harness/generate-audition-matrix.mjs",
    "lab:audition:strict": "node AMP_SIM_LAB/test-harness/generate-audition-matrix.mjs --strict",
    "lab:audition:render": "node AMP_SIM_LAB/test-harness/render-hook/run-audition-render.mjs",
    "lab:reference:feedback:plan": "node AMP_SIM_LAB/test-harness/create-reference-feedback-plan.mjs",
    "lab:reference:pack": "node AMP_SIM_LAB/test-harness/create-reference-listening-pack.mjs",
    "lab:reference:serve": "node AMP_SIM_LAB/test-harness/serve-reference-listening-pack.mjs",
    "lab:ir:audition": "node AMP_SIM_LAB/test-harness/create-ir-reference-audition.mjs",
    "lab:render": "node AMP_SIM_LAB/test-harness/render-hook/run-render.mjs",
    "lab:render:dry-run": "node AMP_SIM_LAB/test-harness/render-hook/run-render.mjs --dry-run",
    "lab:render:strict": "node AMP_SIM_LAB/test-harness/render-hook/run-render.mjs --dry-run --strict-safety",
    "lab:render:safety": "node AMP_SIM_LAB/test-harness/render-hook/render-safety.mjs",
    "lab:baseline:create": "node AMP_SIM_LAB/test-harness/render-hook/baseline-create.mjs",
    "lab:baseline:compare": "node AMP_SIM_LAB/test-harness/render-hook/baseline-compare.mjs",
    "lab:validate-presets": "node AMP_SIM_LAB/test-harness/validate-presets.mjs",
    "lab:presets": "npm run lab:validate-presets",
    "lab:beta-pack": "node AMP_SIM_LAB/test-harness/create-beta-pack.mjs",
    "lab:release": "node AMP_SIM_LAB/test-harness/validate-release-artifacts.mjs",
    "lab:beta-readiness": "node AMP_SIM_LAB/test-harness/generate-beta-readiness.mjs",
    "lab:beta-readiness:strict": "node AMP_SIM_LAB/test-harness/generate-beta-readiness.mjs --strict",
    "lab:report-index": "node AMP_SIM_LAB/test-harness/generate-report-index.mjs",
    "lab:dashboard": "node AMP_SIM_LAB/test-harness/generate-dashboard.mjs",
    "lab:all": "node AMP_SIM_LAB/test-harness/run-lab-all.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.0"
  }
}
